---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bio from '../components/Bio.astro';
import Monogram from '../components/Monogram.astro';
import ContentTable from '../components/ContentTable.astro';
import ContentPopover from '../components/ContentPopover.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection, render } from 'astro:content';
const caseStudies = await getCollection('case-studies');
const futures = await getCollection('futures');
const ideas = await getCollection('ideas');
const playground = await getCollection('playground');
const cvEntries = await getCollection('cv');

type ContentEntry = {
  id: string;
  title: string;
  description: string;
  context?: string;
  date: Date;
  type: string;
  image?: string | null;
  altText?: string;
  role?: string;
  projectDate?: string;
  link?: string;
  url?: string;
};

const allContent: ContentEntry[] = [
  ...caseStudies.map(e => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    context: e.data.context,
    date: e.data.date,
    type: 'case-study',
    image: e.data.image,
    altText: e.data['alt-text'],
    role: e.data.role,
    projectDate: e.data.projectDate,
  })),
  ...futures.map(e => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    context: e.data.context,
    date: e.data.date,
    type: 'futures',
    image: e.data.image,
    altText: e.data['alt-text'],
    role: e.data.role,
    projectDate: e.data.projectDate,
  })),
  ...ideas.map(e => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    context: e.data.context,
    date: e.data.date,
    type: 'idea',
    image: e.data.image,
    altText: e.data['alt-text'],
    role: e.data.role,
    projectDate: e.data.projectDate,
  })),
  ...playground.map(e => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    context: e.data.context,
    date: e.data.date,
    type: 'playground',
    image: e.data.image,
    link: e.data.link,
  })),
  ...cvEntries.map(e => ({
    id: e.id,
    title: e.data.company,
    description: e.data.description,
    context: e.data.company,
    date: e.data.date,
    type: 'cv',
    image: e.data.image,
    role: e.data.role,
    projectDate: e.data.dates,
    url: e.data.url,
  })),
];

allContent.sort((a, b) => b.date.getTime() - a.date.getTime());

const renderedContent = await Promise.all(
  [...caseStudies, ...futures, ...ideas, ...playground, ...cvEntries].map(async (entry) => {
    const { Content } = await render(entry);
    return { id: entry.id, Content };
  })
);

const dataIsland = allContent.map(e => ({
  id: e.id,
  title: e.title,
  image: e.image || null,
  altText: e.altText || null,
  context: e.context || null,
  role: e.role || null,
  projectDate: e.projectDate || null,
  type: e.type,
  link: e.link || null,
  url: e.url || null,
}));
---

<Base>
  <main>
    <Hero />
    <Bio />
    <ContentTable entries={allContent} />
    <Monogram />

    {renderedContent.map(({ id, Content }) => (
      <div id={`content-${id}`} hidden>
        <Content />
      </div>
    ))}

    <script type="application/json" id="content-data" set:html={JSON.stringify(dataIsland)} />

    <ContentPopover />
    <ThemeToggle />
  </main>
</Base>
