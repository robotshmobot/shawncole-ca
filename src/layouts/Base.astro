---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'shawncole.ca' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/sc-favicon.ico" sizes="32x32" />
    <link rel="icon" href="/sc-favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/sc-favicon-apple.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/faune-display-black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') {
          document.documentElement.setAttribute('data-theme', t);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
