---
import { getCollection, render } from 'astro:content';

const siteEntries = await getCollection('site');
const siteEntry = siteEntries[0];
const destinations = (siteEntry?.data?.destinations ?? []).map((d: string) => {
  const [name, url] = d.split(' | ');
  return { name: name.trim(), url: url.trim() };
});
const { Content } = await render(siteEntry);
---

<section class="bio">
  <div class="bio__text">
    <Content />
  </div>
  <div class="bio__destinations">
    <h3 class="bio__destinations-heading">Destinations</h3>
    {destinations.map((d) => (
      <a href={d.url} target="_blank" rel="noopener" class="bio__dest-row">
        <span class="bio__dest-name">{d.name}</span>
        <svg class="bio__dest-arrow" width="21" height="7" viewBox="0 0 21 7" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 3.35358H20M17 6.35358L20 3.35358L17 0.353577" stroke="currentColor"/></svg>
      </a>
    ))}
  </div>
</section>

<style>
  .bio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 64px 40px;
  }

  .bio__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bio__text :global(p) {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-body-text);
  }

  .bio__destinations {
    display: flex;
    flex-direction: column;
  }

  .bio__destinations-heading {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    padding: 10px 8px;
    border-bottom: 1px solid var(--color-text);
  }

  .bio__dest-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 8px;
    border-bottom: 1px solid var(--color-text);
    text-decoration: none;
    color: var(--color-body-text);
    font-family: var(--font-body);
    font-size: 18px;
    transition: background 0.1s, color 0.1s;
  }

  .bio__dest-row:hover {
    background: var(--color-header-bg);
    color: var(--color-header-text);
  }

  .bio__dest-arrow {
    width: 21px;
    height: 7px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .bio {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 40px 16px;
    }
  }
</style>
